# Copy this file to ".env" (in this folder, or in the project root) and fill in real values.
# This app also automatically finds the ".env" file at the root of the repo, so if
# PINECONE_API_KEY / GROQ_API_KEY are already set there, you don't need a separate one here.

PINECONE_API_KEY=your-pinecone-api-key
GROQ_API_KEY=your-groq-api-key
