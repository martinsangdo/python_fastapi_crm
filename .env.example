# Copy this file to ".env" and fill in your real values.
#
# PostgreSQL / Supabase connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#
# Supabase example (find these details in your Supabase project settings):
# DATABASE_URL=postgresql+psycopg://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# ---------------------------------------------------------------------------
# JWT (JSON Web Token) settings used by the authentication module.
# ---------------------------------------------------------------------------
#
# JWT_SECRET_KEY signs every token. Keep it long, random, and SECRET.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-string

# The algorithm used to sign tokens. HS256 is a good, simple default.
JWT_ALGORITHM=HS256

# How long an access token stays valid (in minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# How long a refresh token stays valid (in days).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Groq AI (https://console.groq.com/keys) — powers the dashboard's "ask about
# the data" chatbot and the daily summary email's write-up.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# Optional — defaults to "openai/gpt-oss-120b" (fast, hosted on Groq) if unset.
# GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Resend (https://resend.com/api-keys) — sends the daily summary email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
# The "from" address Resend sends as. "onboarding@resend.dev" works without
# any setup, but can only deliver to the email you signed up to Resend with.
# Verify your own domain in Resend to send from/to any address.
RESEND_FROM_EMAIL=onboarding@resend.dev
# The director's email address that receives the daily sales summary.
DAILY_SUMMARY_EMAIL=director@example.com

# ---------------------------------------------------------------------------
# Public task API (routers/public_tasks.py) — endpoints called by an
# external scheduler (e.g. a daily cron job), not a logged-in browser user.
# ---------------------------------------------------------------------------
# Shared secret the scheduler must send as header "X-API-Key".
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PUBLIC_TASK_API_KEY=change-me-to-a-long-random-secret-string

# Timezone "today"/"yesterday" are measured in for the daily summary.
APP_TIMEZONE=UTC
