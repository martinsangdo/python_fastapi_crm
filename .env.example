# Copy this file to ".env" and fill in your real values.
#
# PostgreSQL / Supabase connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#
# Supabase example (find these details in your Supabase project settings):
# DATABASE_URL=postgresql+psycopg://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/postgres

# ---------------------------------------------------------------------------
# JWT (JSON Web Token) settings used by the authentication module.
# ---------------------------------------------------------------------------
#
# JWT_SECRET_KEY signs every token. Keep it long, random, and SECRET.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-string

# The algorithm used to sign tokens. HS256 is a good, simple default.
JWT_ALGORITHM=HS256

# How long an access token stays valid (in minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# How long a refresh token stays valid (in days).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Public customer-care task (routers/tasks.py) — checks the `customers`
# table for new signups today and, if there are any, creates a Google
# Calendar follow-up event listing them (calling it twice in a day will NOT
# create a duplicate — see _EVENT_MARKER_KEY in customer_care_service.py).
# Meant to be called once a day by an external scheduler (cron, Google Cloud
# Scheduler, cron-job.org, ...), not a browser. See public_auth.py and
# service/google_calendar_service.py for full setup notes.
# ---------------------------------------------------------------------------

# Shared secret the scheduler must send as header "X-API-Key" on every call.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Required — with this unset, the endpoint refuses every request (503).
PUBLIC_TASK_API_KEY=change-me-to-a-long-random-secret-string

# Timezone "today" is measured in when checking for new customers.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# The reminder event is scheduled this many days AFTER today (a follow-up
# check-in), at this time of day, running for this long.
CUSTOMER_CARE_EVENT_OFFSET_DAYS=7
CUSTOMER_CARE_EVENT_HOUR=15
CUSTOMER_CARE_EVENT_MINUTE=0
CUSTOMER_CARE_EVENT_DURATION_MINUTES=30

# Path to the Google service-account JSON key file you download from Google
# Cloud Console (IAM & Admin -> Service Accounts -> Keys -> Add Key). Keep
# this file OUT of version control (already covered by .gitignore's *.json
# rule) — never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json

# The Google Calendar to create events on — usually the owner's email
# address for a personal calendar (Settings and sharing -> Integrate
# calendar -> Calendar ID). Do NOT use "primary": that means the SERVICE
# ACCOUNT's own hidden calendar, which no human can see. The calendar must
# first be shared with the service account's email (found in the JSON key
# file's "client_email" field) with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=your-team-calendar@gmail.com

# ---------------------------------------------------------------------------
# Public "new customers today" email task (routers/tasks.py) — checks the
# `customers` table for new signups today and, if there are any, emails ONE
# summary via Resend (https://resend.com). See service/email_service.py for
# full setup notes.
# ---------------------------------------------------------------------------

# Resend API key (Dashboard -> API Keys).
RESEND_API_KEY=re_your_resend_api_key

# The "from" address Resend sends as. "onboarding@resend.dev" works without
# any setup, but can only deliver to the email you signed up to Resend with.
# Verify your own domain in Resend to send from/to any address.
RESEND_FROM_EMAIL=onboarding@resend.dev

# The Gmail (or any) address that receives the daily summary email.
CUSTOMER_CARE_NOTIFY_EMAIL=your-team@gmail.com
